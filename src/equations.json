  "id": "e_{ij} = \\begin{cases} b_{ij}, & i \\in P_{j} \\\\ \\operatorname{cor}(\\hat{\\eta}_{i},\\hat{\\eta}_{j}), & j \\in P_{i} \\\\ 0, & \\text{lainnya} \\end{cases}"
 },
 "modeA": "w_{kj} \\propto \\operatorname{cov}\\left(x_{kj},\\,\\tilde{\\eta}_{j}\\right)",
