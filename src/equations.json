 "ci": "\\mathrm{CI}_{1-\\alpha} = \\left[\\hat{\\beta}^{*}_{(\\alpha/2)},\\ \\hat{\\beta}^{*}_{(1-\\alpha/2)}\\right]",
 "indirect": "\\beta_{X \\rightarrow M \\rightarrow Y} = \\beta_{XM}\\,\\beta_{MY}",
 "srmr": "\\mathrm{SRMR} = \\sqrt{\\frac{2}{p(p+1)}\\sum_{i \\le j}\\left(r_{ij} - \\hat{r}_{ij}\\right)^{2}}",
 "q2": "Q_{\\mathrm{predict}}^{2} = 1 - \\frac{\\sum_{i}\\left(y_{i} - \\hat{y}_{i}\\right)^{2}}{\\sum_{i}\\left(y_{i} - \\bar{y}_{\\mathrm{train}}\\right)^{2}}",
 "rmse": "\\mathrm{RMSE} = \\sqrt{\\frac{1}{N}\\sum_{i=1}^{N}\\left(y_{i} - \\hat{y}_{i}\\right)^{2}},\\qquad \\mathrm{MAE} = \\frac{1}{N}\\sum_{i=1}^{N}\\left|y_{i} - \\hat{y}_{i}\\right|",
 "nmin": {
