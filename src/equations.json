 "rhoa": "\\rho_{A} = \\left(\\hat{\\mathbf{w}}^{\\top}\\hat{\\mathbf{w}}\\right)^{2}\\frac{\\hat{\\mathbf{w}}^{\\top}\\left(\\mathbf{S}-\\operatorname{diag}\\mathbf{S}\\right)\\hat{\\mathbf{w}}}{\\hat{\\mathbf{w}}^{\\top}\\left(\\hat{\\mathbf{w}}\\hat{\\mathbf{w}}^{\\top}-\\operatorname{diag}(\\hat{\\mathbf{w}}\\hat{\\mathbf{w}}^{\\top})\\right)\\hat{\\mathbf{w}}}",
 "ave": "\\mathrm{AVE} = \\frac{1}{K}\\sum_{k=1}^{K}\\lambda_{k}^{2}",
 "htmt": "\\mathrm{HTMT}_{ij} = \\frac{\\bar{r}_{ij}}{\\sqrt{\\bar{r}_{ii}\\,\\bar{r}_{jj}}}",
 "vif": "\\mathrm{VIF}_{k} = \\frac{1}{1 - R_{k}^{2}}",
 "r2": "R_{j}^{2} = 1 - \\frac{\\operatorname{Var}(\\hat{\\zeta}_{j})}{\\operatorname{Var}(\\hat{\\eta}_{j})},\\qquad R_{\\mathrm{adj}}^{2} = 1 - \\left(1 - R_{j}^{2}\\right)\\frac{n-1}{n-p_{j}-1}",
 "f2": "f^{2} = \\frac{R_{\\mathrm{incl}}^{2} - R_{\\mathrm{excl}}^{2}}{1 - R_{\\mathrm{incl}}^{2}}",
